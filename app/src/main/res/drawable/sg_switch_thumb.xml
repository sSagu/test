<?xml version="1.0" encoding="utf-8"?>
<!-- android.widget.Switch thumb: 24 dp knob, 1 dp horizontal padding, 4 dp top/bottom inset.
     Thumb width 22 dp, so the switch measures 52x32 dp (switchMinWidth) with a 20 dp knob travel.
     #0B1A33 when on, #C8C8D0 when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list android:paddingLeft="1dp" android:paddingRight="1dp">
            <item android:top="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/sg_on_accent" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list android:paddingLeft="1dp" android:paddingRight="1dp">
            <item android:top="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/sg_thumb_off" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
