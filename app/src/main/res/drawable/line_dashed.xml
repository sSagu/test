<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed 8 h target line (#6B6B73). Use on a View 2 dp high with
     android:layerType="software" so the dash effect renders on every device. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="line">
    <stroke android:width="1dp" android:color="@color/sg_target_line"
        android:dashWidth="4dp" android:dashGap="4dp" />
</shape>
