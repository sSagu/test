<?xml version="1.0" encoding="utf-8"?>
<!-- Stepper circle: 44 dp visual inside a 48 dp hit area (2 dp inset), outline + ripple. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="2dp">
    <ripple android:color="@color/sg_ripple">
        <item>
            <shape android:shape="oval">
                <solid android:color="@android:color/transparent" />
                <stroke android:width="1dp" android:color="@color/sg_outline" />
            </shape>
        </item>
    </ripple>
</inset>
