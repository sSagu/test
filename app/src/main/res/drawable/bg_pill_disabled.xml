<?xml version="1.0" encoding="utf-8"?>
<!-- Disabled pill: #101012 fill, 1 dp #2A2A30 stroke. Not touchable, no ripple. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/sg_disabled_fill" />
    <stroke android:width="1dp" android:color="@color/sg_disabled_stroke" />
    <corners android:radius="@dimen/sg_pill_radius" />
</shape>
